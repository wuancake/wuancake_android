<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >
    <View
        android:layout_width="match_parent"
        android:layout_height="40pt"
        android:background="@color/wuan_black"
        />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="110pt"
        android:background="@color/wuan_blue"
        android:layout_gravity="center_horizontal"
        >
        <ImageView
            android:id="@+id/qg_img"
            android:layout_width="50pt"
            android:layout_height="match_parent"
            android:src="@drawable/ret"
            android:layout_marginLeft="25pt"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="60pt"
            android:text="@string/title_qg"
            android:layout_centerInParent="true"
            android:layout_marginTop="34pt"
            android:textColor="@color/wuan_white"
            android:gravity="center"
            android:textSize="45pt"
            />
        

    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="256pt"
        android:layout_marginTop="118pt"
        android:layout_marginLeft="70pt"
        android:layout_marginRight="70pt"
        android:background="@drawable/card_border"
        android:elevation="6pt"
        android:gravity="center_vertical"
        android:orientation="vertical"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt1_qg"
            android:textSize="26pt"
            android:layout_margin="10pt"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt2_qg"
            android:textSize="26pt"
            android:layout_margin="10pt"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt3_qg"
            android:textSize="26pt"
            android:layout_margin="10pt"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt4_qg"
            android:textSize="26pt"
            android:layout_margin="10pt"
            />
    </LinearLayout>
    <Button
        android:id="@+id/qg_btn"
        android:layout_width="350pt"
        android:layout_height="70pt"
        android:background="@drawable/up"
        android:textColor="@color/wuan_white"
        android:layout_marginTop="140pt"
        android:text="@string/btn_qg"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:textSize="36pt"
        />

</LinearLayout>
