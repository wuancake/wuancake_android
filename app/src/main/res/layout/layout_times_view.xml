<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        >
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="距离"
                android:textColor="@color/wuan_white"
                android:textSize="19sp"
                />
            <TextView
                android:id="@+id/weeks_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="000"
                android:textSize="19sp"
                android:textColor="@color/wuan_white"
                android:layout_marginLeft="15pt"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:textColor="@color/wuan_white"
                android:text="周"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="结束"
                android:layout_marginLeft="15pt"
                android:textColor="@color/wuan_white"
                android:textSize="19sp"
                />
        </LinearLayout>
    </FrameLayout>


    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20pt"
        android:layout_gravity="center_horizontal"
        >


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            >
            <TextView
                android:id="@+id/days_txt"
                android:layout_width="95pt"
                android:layout_height="95pt"
                android:background="@drawable/button_border"
                android:text="0"
                android:textSize="30sp"
                android:textColor="@color/wuan_blue"
                android:elevation="2pt"
                android:gravity="center"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wuan_white"
                android:textSize="12sp"
                android:text="天"
                android:layout_gravity="center"
                android:layout_marginLeft="20pt"
                />
            <TextView
                android:id="@+id/hour_txt"
                android:layout_width="95pt"
                android:layout_height="95pt"
                android:background="@drawable/button_border"
                android:text="00"
                android:textSize="30sp"
                android:textColor="@color/wuan_blue"
                android:gravity="center"
                android:elevation="2pt"
                android:layout_marginLeft="20pt"

                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wuan_white"
                android:textSize="12sp"
                android:text="时"
                android:layout_gravity="center"
                android:layout_marginLeft="20pt"
                />
            <TextView
                android:id="@+id/minute_txt"
                android:layout_width="95pt"
                android:layout_height="95pt"
                android:background="@drawable/button_border"
                android:text="00"
                android:textSize="30sp"
                android:textColor="@color/wuan_blue"
                android:elevation="2pt"
                android:gravity="center"
                android:layout_marginLeft="20pt"

                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wuan_white"
                android:textSize="12sp"
                android:text="分"
                android:layout_gravity="center"
                android:layout_marginLeft="20pt"
                />
            <TextView
                android:id="@+id/s_txt"
                android:layout_width="95pt"
                android:layout_height="95pt"
                android:background="@drawable/button_border"
                android:text="00"
                android:textSize="30sp"
                android:textColor="@color/wuan_blue"
                android:elevation="2pt"
                android:gravity="center"
                android:layout_marginLeft="20pt"

                />


        </LinearLayout>
    </FrameLayout>
</LinearLayout>
