<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="300pt"
        android:background="@color/wuan_blue"
        android:orientation="vertical"
        >
        <ImageView
            android:id="@+id/mwr_img"
            android:layout_width="220pt"
            android:layout_height="182pt"
            android:src="@mipmap/logo1"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="42pt"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/title_mwr"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/wuan_white"
            android:textSize="60pt"
            android:gravity="center_vertical"

            />

    </LinearLayout>

    <android.support.v7.widget.RecyclerView
        android:id="@+id/mwr_view"
        android:layout_width="match_parent"
        android:layout_height="720pt"
        android:layout_marginTop="62pt"
        android:layout_marginRight="80pt"
        android:layout_marginLeft="80pt"
        />


</LinearLayout>
