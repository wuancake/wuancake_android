<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/wuan_blue"
        >
        <ImageView
            android:id="@+id/lwr_img"
            android:layout_width="11dp"
            android:layout_height="30dp"
            android:src="@mipmap/left"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="17dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/lr"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="17dp"
            android:textColor="@color/wuan_white"
            android:gravity="center"
            android:textSize="36px"
            />

    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="horizontal"
        android:layout_marginTop="40dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:background="@drawable/card_border"
        android:elevation="2dp"
        >
        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/wuan_blue"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/weeks_lwr_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wuan_blue"
                android:textSize="30px"
                android:text="第143周"
                android:layout_marginTop="5dp"

                />
            <TextView
                android:id="@+id/finish_lwr_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本周完成："
                android:textColor="@color/wuan_word"

                />
            <TextView
                android:id="@+id/trouble_lwr_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="所遇困难："
                android:textColor="@color/wuan_word"
                />
            <TextView
                android:id="@+id/plan_lwr_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下周计划："
                android:textColor="@color/wuan_word"
                />
            <TextView
                android:id="@+id/url_lwr_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="作品连接："
                android:textColor="@color/wuan_word"
                />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
