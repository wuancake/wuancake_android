<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent">
    <View
        android:layout_width="match_parent"
        android:layout_height="40pt"
        android:background="@color/wuan_black"
        />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="110pt"
        android:background="@color/wuan_blue"
        >
        <ImageView
            android:id="@+id/lwr_img"
            android:layout_width="50pt"
            android:layout_height="match_parent"
            android:src="@drawable/ret"
            android:layout_marginLeft="25pt"
            android:layout_gravity="center_vertical"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="60pt"
            android:text="@string/lr"
            android:layout_centerInParent="true"
            android:layout_marginTop="34pt"
            android:textColor="@color/wuan_white"
            android:gravity="center"
            android:textSize="45pt"
            />

    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="400pt"
        android:orientation="horizontal"
        android:layout_marginTop="80pt"
        android:layout_marginLeft="80pt"
        android:layout_marginRight="80pt"
        android:background="@drawable/card_border"
        android:elevation="4pt"
        >
        <View
            android:layout_width="6pt"
            android:layout_height="match_parent"
            android:background="@color/wuan_blue"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16pt"
            android:layout_marginRight="16pt"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/weeks_lwr_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wuan_blue"
                android:textSize="36pt"
                android:text="---"
                android:layout_marginTop="10pt"

                />
            <TextView
                android:id="@+id/finish_lwr_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本周完成："
                android:textColor="@color/wuan_word"
                android:layout_marginTop="10pt"
                android:textSize="30pt"

                />
            <TextView
                android:id="@+id/trouble_lwr_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="所遇困难："
                android:textColor="@color/wuan_word"
                android:layout_marginTop="10pt"
                android:textSize="30pt"
                />
            <TextView
                android:id="@+id/plan_lwr_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下周计划："
                android:textColor="@color/wuan_word"
                android:layout_marginTop="10pt"
                android:textSize="30pt"
                />
            <TextView
                android:id="@+id/url_lwr_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="作品连接："
                android:textColor="@color/wuan_word"
                android:layout_marginTop="10pt"
                android:textSize="30pt"
                />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
