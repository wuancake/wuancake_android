<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@mipmap/indexe"
    >
    <ImageView
        android:layout_width="212pt"
        android:layout_height="220pt"
        android:layout_marginTop="40pt"
        android:src="@mipmap/clock"
        android:layout_gravity="center_horizontal"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="本周已请假"
        android:textColor="@color/wuan_white"
        android:layout_marginTop="36pt"
        android:textSize="23sp"
        android:layout_gravity="center_horizontal"
        />
    <include
        android:layout_marginTop="28pt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        layout="@layout/layout_time_view"/>

    <Button
        android:id="@+id/leave_btn"
        android:layout_width="match_parent"
        android:layout_height="70pt"
        android:background="@drawable/button"
        android:text="取消请假"
        android:textSize="40pt"
        android:textColor="@color/wuan_blue"
        android:layout_marginLeft="180pt"
        android:layout_marginRight="180pt"
        android:layout_marginTop="60pt"/>
</LinearLayout>
