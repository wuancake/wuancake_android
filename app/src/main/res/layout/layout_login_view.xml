<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/wuan_blue"
    android:orientation="vertical"
    android:layout_height="match_parent">

    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/y600"
        android:layout_marginLeft="@dimen/x130"
        android:layout_marginRight="@dimen/x130"
        android:background="@drawable/login_card"
        android:layout_marginTop="@dimen/y182"
        android:orientation="vertical"
        >

        <TextView
            android:layout_width="@dimen/x290"
            android:layout_height="wrap_content"
            android:text="@string/login_title"
            android:textColor="@color/wuan_blue"
            android:textSize="@dimen/x36"
            android:layout_marginLeft="@dimen/x102"
            android:layout_marginTop="@dimen/y52"

            />
        
        <LinearLayout
            android:layout_width="@dimen/x342"
            android:layout_height="@dimen/y42"
            android:orientation="horizontal"
            android:layout_marginLeft="@dimen/x50"
            android:layout_marginTop="@dimen/y84"
            >
            <ImageView
                android:layout_width="@dimen/x32"
                android:layout_height="@dimen/y42"
                android:src="@mipmap/human"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="@dimen/x20"
                >
            <EditText
                android:id="@+id/eamil_txt"
                android:layout_width="match_parent"
                android:layout_height="@dimen/y35"
                android:hint="@string/login_eamil"
                android:background="@null"
                android:gravity="bottom"

                android:layout_marginTop="@dimen/y5"
                android:textSize="12sp"

                />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/y1"
                    android:background="@color/wuan_word"

                    />
            </LinearLayout>
            
        </LinearLayout>
        <LinearLayout
            android:layout_width="@dimen/x342"
            android:layout_height="@dimen/y42"
            android:orientation="horizontal"
            android:layout_marginLeft="@dimen/x50"
            android:layout_marginTop="@dimen/y52"
            >
            <ImageView
                android:layout_width="@dimen/x32"
                android:layout_height="@dimen/y42"
                android:src="@mipmap/lock1"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="@dimen/x20"
                >
                <EditText
                    android:id="@+id/pwd_txt"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/y35"
                    android:hint="@string/login_pwd"
                    android:background="@null"
                    android:gravity="bottom"
                    android:inputType="textPassword"
                    android:layout_marginTop="@dimen/y5"
                    android:textSize="@dimen/x25"

                    />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/y1"
                    android:background="@color/wuan_word"

                    />
            </LinearLayout>

        </LinearLayout>
        
        <Button
            android:id="@+id/login_btn"
            android:layout_width="@dimen/x290"
            android:layout_height="@dimen/y60"
            android:background="@drawable/login"
            android:text="@string/login_txt"
            android:layout_marginLeft="@dimen/x102"
            android:textColor="@color/wuan_white"
            android:layout_marginTop="@dimen/y65"
            android:textSize="@dimen/x30"
            />
        
        <LinearLayout
            android:layout_width="@dimen/x270"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x132"
            android:layout_marginTop="@dimen/y16"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_txt1"
                android:textSize="@dimen/x25"
                />
            <TextView
                android:id="@+id/login_regist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_txt2"
                android:textColor="@drawable/text"
                android:textSize="@dimen/x25"

                />


        </LinearLayout>


    </LinearLayout>


    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x217"
        android:layout_marginLeft="@dimen/x532"
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <LinearLayout
                android:layout_width="@dimen/x145"
                android:layout_height="@dimen/x25"
                android:orientation="horizontal"
                >
                <View
                    android:layout_width="@dimen/x105"
                    android:layout_height="match_parent"
                    android:background="@drawable/login_btn2"
                    />
                <ImageView
                    android:layout_width="@dimen/x25"
                    android:layout_height="@dimen/x25"
                    android:src="@mipmap/circle"
                    android:layout_marginLeft="@dimen/x15"
                    />

            </LinearLayout>
            <View
                android:layout_width="@dimen/x105"
                android:layout_height="@dimen/x25"
                android:background="@drawable/login_btn"
                />
            <View
                android:layout_width="@dimen/x85"
                android:layout_height="@dimen/x25"
                android:background="@drawable/login_btn2"
                />



        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x670"
        android:layout_marginLeft="@dimen/x30"
        >
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

        <View
            android:layout_width="@dimen/x120"
            android:layout_height="@dimen/x25"
            android:background="@drawable/login_btn2"
            android:layout_gravity="right"
            />
        <View
            android:layout_width="@dimen/x150"
            android:layout_height="@dimen/x25"
            android:background="@drawable/login_btn"
            android:layout_gravity="right"
            />
            <LinearLayout
                android:layout_width="@dimen/x190"
                android:layout_height="@dimen/x25">

                <ImageView
                    android:layout_width="@dimen/x25"
                    android:layout_height="@dimen/x25"
                    android:src="@mipmap/circle"

                    />
                <View
                    android:layout_width="@dimen/x150"
                    android:layout_height="@dimen/x25"
                    android:layout_marginLeft="@dimen/x15"
                    android:background="@drawable/login_btn2"
                    />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
