<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/wuan_blue"
        >
        <ImageView
            android:id="@+id/qg_img"
            android:layout_width="11dp"
            android:layout_height="30dp"
            android:src="@mipmap/left"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="17dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/title_un"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="17dp"
            android:textColor="@color/wuan_white"
            android:gravity="center"
            android:textSize="36px"
            />


    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="53dp"
        android:layout_marginLeft="53dp"
        android:background="@drawable/card_border"
        android:orientation="horizontal"
        android:elevation="3dp"
        >
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/wuan_blue"
            />
        <EditText
            android:id="@+id/op_txt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/n_un"
            android:background="@null"
            android:layout_margin="5dp"
            android:gravity="center_vertical"
            android:textColorHint="@color/wuan_word"
            />

    </LinearLayout>
    <Button
        android:id="@+id/save_name_btn"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:textColor="@color/wuan_white"
        android:background="@drawable/up_btn"
        android:textSize="36px"
        android:text="@string/s_un"
        android:layout_marginTop="66dp"
        android:layout_marginRight="53dp"
        android:layout_marginLeft="53dp"
        />
</LinearLayout>
