<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/indexw"
    android:orientation="vertical"
    >
    <ImageView
        android:id="@+id/img"
        android:layout_width="214pt"
        android:layout_height="208pt"
        android:src="@mipmap/clock1"
        android:layout_marginTop="24pt"
        android:layout_gravity="center_horizontal"
        />

    <include
        layout="@layout/layout_times_view"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_marginTop="30pt"
        android:layout_gravity="center_horizontal"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="300pt"
        >
        <Button
            android:id="@+id/submit_btn"
            android:layout_width="match_parent"
            android:layout_height="80pt"
            android:background="@drawable/up"
            android:text="@string/submit_btn"
            android:textSize="40pt"
            android:textColor="@color/wuan_white"
            android:layout_marginLeft="100pt"
            android:layout_marginRight="100pt"
            android:layout_marginTop="60pt"

            />
        <Button
            android:id="@+id/leave_btn"
            android:layout_width="match_parent"
            android:layout_height="80pt"
            android:background="@drawable/button"
            android:text="@string/leave_btn"
            android:textSize="40pt"
            android:textColor="@color/wuan_blue"
            android:layout_marginLeft="100pt"
            android:layout_marginRight="100pt"
            android:layout_marginTop="60pt" />
    </LinearLayout>

</LinearLayout>
